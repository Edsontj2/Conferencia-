<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Barra lateral -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/railClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/btnHome"
                style="@style/RailButton"
                android:background="@drawable/bg_btn_selected"
                android:contentDescription="Início"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/btnDash"
                style="@style/RailButton"
                android:contentDescription="Painel de direção"
                android:src="@drawable/ic_speed" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/RailButton"
                android:contentDescription="Ajustes"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <!-- Tela inicial -->
            <FrameLayout
                android:id="@+id/homeScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/homeBt"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bluetooth"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/homeBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="--%"
                        android:textColor="@color/text"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:orientation="vertical">

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="HH:mm"
                            android:format24Hour="HH:mm"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="76sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="#FFD8DDE3"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/homeGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/text_dim"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tileNav"
                            style="@style/Tile">

                            <ImageView
                                style="@style/TileIcon"
                                android:src="@drawable/ic_navigation"
                                android:tint="@color/accent" />

                            <TextView
                                style="@style/TileLabel"
                                android:text="Navegação" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileMusic"
                            style="@style/Tile">

                            <ImageView
                                style="@style/TileIcon"
                                android:src="@drawable/ic_music"
                                android:tint="@color/music" />

                            <TextView
                                style="@style/TileLabel"
                                android:text="Música" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tilePhone"
                            style="@style/Tile">

                            <ImageView
                                style="@style/TileIcon"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/phone" />

                            <TextView
                                style="@style/TileLabel"
                                android:text="Telefone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tileApps"
                            style="@style/Tile">

                            <ImageView
                                style="@style/TileIcon"
                                android:src="@drawable/ic_apps" />

                            <TextView
                                style="@style/TileLabel"
                                android:text="Aplicativos" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_btn"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ajustes"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Painel de direção -->
            <LinearLayout
                android:id="@+id/dashScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

        <!-- Navegação + velocímetro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/navCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/navIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_navigation" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Waze"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Toque para abrir a navegação"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <com.edson.carlauncher.SpeedometerView
                android:id="@+id/speedo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnGoHome"
                    style="@style/Chip"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_home"
                    android:text="Casa" />

                <TextView
                    android:id="@+id/btnGoWork"
                    style="@style/Chip"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_work"
                    android:text="Trabalho" />

                <TextView
                    android:id="@+id/btnOpenWaze"
                    style="@style/Chip"
                    android:drawableStart="@drawable/ic_navigation"
                    android:text="Waze" />
            </LinearLayout>
        </LinearLayout>

        <!-- Música -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_bluetooth"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--%"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1">

                <com.edson.carlauncher.SquareImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_art"
                    android:padding="0dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/mediaHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC000000"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Toque aqui para permitir o controle da música (acesso às notificações)"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Nenhuma música"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="Toque ▶ para abrir o YouTube Music"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:contentDescription="Anterior"
                    android:scaleType="center"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="Tocar ou pausar"
                    android:scaleType="center"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:contentDescription="Próxima"
                    android:scaleType="center"
                    android:src="@drawable/ic_next" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="@color/track"
                android:progressTint="@color/accent" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/timeCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text="0:00"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/timeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="0:00"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:contentDescription="Diminuir volume"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/btnVol"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:contentDescription="Volume"
                    android:src="@drawable/ic_volume" />

                <ImageButton
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:contentDescription="Aumentar volume"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>
        </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Gaveta de aplicativos -->
    <LinearLayout
        android:id="@+id/appsLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F507090C"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Aplicativos"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/appsClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="Fechar"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <GridView
            android:id="@+id/appsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="104dp"
            android:gravity="center"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />
    </LinearLayout>

    <!-- Modo relógio (quando ninguém está mexendo) -->
    <FrameLayout
        android:id="@+id/idleLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/idleContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="120sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d 'de' MMMM"
                android:format24Hour="EEEE, d 'de' MMMM"
                android:textColor="@color/text_dim"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/idleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/accent"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
