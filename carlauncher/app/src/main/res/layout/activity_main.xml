<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Barra lateral -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rail"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_bluetooth"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/railWaze"
                style="@style/RailApp"
                android:contentDescription="Waze" />

            <ImageView
                android:id="@+id/railMusic"
                style="@style/RailApp"
                android:contentDescription="YouTube Music" />

            <ImageView
                android:id="@+id/railPhone"
                style="@style/RailApp"
                android:contentDescription="Telefone" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/railApps"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="Aplicativos"
                android:padding="12dp"
                android:src="@drawable/ic_dots" />
        </LinearLayout>

        <!-- Coluna do painel: velocímetro + música -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="0.85"
            android:orientation="vertical">

            <!-- Velocímetro -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_round"
                android:padding="8dp">

                <com.edson.carlauncher.SpeedometerView
                    android:id="@+id/speedo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/limitBadge"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_limit"
                        android:gravity="center"
                        android:textColor="#FF111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/limitLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="limite"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/roadName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Música -->
            <FrameLayout
                android:id="@+id/musicCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_card_round">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.edson.carlauncher.SquareImageView
                            android:id="@+id/art"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_art"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/trackTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="marquee"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:singleLine="true"
                                    android:textColor="@color/text"
                                    android:textSize="18sp" />

                                <ImageView
                                    android:id="@+id/musicAppIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_marginStart="6dp"
                                    android:contentDescription="Abrir o YouTube Music" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/trackArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/text_dim"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:max="1000"
                        android:progressBackgroundTint="#FF39414D"
                        android:progressTint="@color/text" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/timeCur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/timeTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnVolDown"
                            style="@style/MediaBtn"
                            android:contentDescription="Diminuir volume"
                            android:src="@drawable/ic_minus" />

                        <ImageButton
                            android:id="@+id/btnPrev"
                            style="@style/MediaBtn"
                            android:contentDescription="Anterior"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_circle"
                            android:contentDescription="Tocar ou pausar"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            style="@style/MediaBtn"
                            android:contentDescription="Próxima"
                            android:src="@drawable/ic_next" />

                        <ImageButton
                            android:id="@+id/btnVolUp"
                            style="@style/MediaBtn"
                            android:contentDescription="Aumentar volume"
                            android:src="@drawable/ic_plus" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/mediaHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6000000"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Toque aqui para permitir o controle da música (acesso às notificações)"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Espaço do Waze: a janela pop-up do Waze abre exatamente aqui -->
        <LinearLayout
            android:id="@+id/wazeSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_card_round"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wazeSlotIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_navigation" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Toque para abrir o Waze aqui"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Gaveta de aplicativos -->
    <LinearLayout
        android:id="@+id/appsLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F507090C"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Aplicativos"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/appsSettings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="Ajustes"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/appsClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn"
                android:contentDescription="Fechar"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <GridView
            android:id="@+id/appsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="104dp"
            android:gravity="center"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />
    </LinearLayout>

    <!-- Modo relógio (quando ninguém está mexendo) -->
    <FrameLayout
        android:id="@+id/idleLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/idleContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="120sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d 'de' MMMM"
                android:format24Hour="EEEE, d 'de' MMMM"
                android:textColor="@color/text_dim"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/idleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:textColor="@color/accent"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
