# Copie para .env e ajuste. NÃO coloque este arquivo .env no Git.
PORT=3000
HOST=0.0.0.0
# Pasta onde ficam os bancos SQLite (real e demonstração) e cópias automáticas de backup
DATA_DIR=./data
# Administrador criado automaticamente na primeira execução (se ainda não existir nenhum).
# Depois de entrar, troque a senha em Configurações ou rode: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Cookie de sessão só por HTTPS. Use true em produção atrás de HTTPS.
# Deixe vazio para detectar automaticamente (req.secure / X-Forwarded-Proto via proxy).
COOKIE_SECURE=
