# Copie para .env (uso local) ou cadastre em Vercel → Settings → Environment Variables.
# NÃO coloque o arquivo .env no Git.

# Banco Postgres do Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
# Vazio = usa um Postgres embutido (PGlite) na pasta DATA_DIR (uso local/servidor próprio).
DATABASE_URL=

# Administrador criado automaticamente se ainda não existir nenhum.
# Depois de entrar, troque a senha em Configurações.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Aplica uma vez as escalas reais transcritas do papel (server/seed-data.ts). Use false para começar vazio.
SEED_REAL_DATA=true

# Cookie de sessão só por HTTPS (na Vercel já é true por padrão).
COOKIE_SECURE=

# --- somente servidor próprio (não usados na Vercel) ---
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
